# cloud-probe build environment
# Copy to .env.local and edit. .env.local is gitignored.

# ─── Build backend ────────────────────────────────────────────────────────
# Where the build actually runs:
#   local — run mage directly in $PWD (used when invoked on a build host)
#   ssh   — rsync project to $BUILD_SSH_HOST, then ssh + mage
#   orb   — run in an OrbStack Linux VM (no rsync; VM shares mac filesystem)
#
# Leave unset to auto-detect (local on a build host, ssh otherwise).
BUILD_MODE=

# ─── SSH backend (BUILD_MODE=ssh) ─────────────────────────────────────────
BUILD_SSH_HOST=                               # e.g. user@host
BUILD_SSH_KEY=                                # optional, e.g. ~/.ssh/id_ed25519
BUILD_REMOTE_DIR=                             # e.g. /home/<user>/cloud-probe

# Root password for one-time `just remote setup` (apt installs etc).
# Used only when the SSH user lacks passwordless sudo — we shell out via `su -`.
# This file is gitignored; never commit a real password.
BUILD_SSH_ROOT_PASSWORD=

# ─── OrbStack backend (BUILD_MODE=orb) ────────────────────────────────────
# Create one with: orb create ubuntu <machine-name>
BUILD_ORB_MACHINE=

# ─── Build env (forwarded to mage on the build host) ──────────────────────
# SDK root containing include/{pcap.h,zmq.h,...} and lib/{libpcap.so,libzmq.a}.
# `just remote setup` will create this skeleton from distro packages.
CPWORKER_LIBRARY_ROOT=                        # e.g. /home/<user>/cpworker-sdk

CLOUD_PROBE_VERSION=0.9.x-dev

# Optional: override the Go module proxy (e.g. when proxy.golang.org is blocked).
GOPROXY=
