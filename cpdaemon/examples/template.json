{
    "listen": {
        "http": {
            "port": 9022
        }
    },
    "log": {
        "level": "info",
        "output": {
            "type": "rotating_file",
            "rotating_file": {
                "file_name": "log/cpdaemon.log",
                "max_size": 100,
                "max_backups": 3,
                "max_age": 30
            }
        }
    },
    "tool": {
        "get_container_host_pid_script": "",
        "get_kvm_instances_script": "",
        "get_kvm_instance_nics_script": ""
    },
    "cgroup": {
        "version": "v1",
        "root": "/sys/fs/cgroup",
        "hierarchy": "cloud-probe"
    },
    "cpm": {
        "base_url": "https://127.0.0.1:48018",
        "client": {
            "tls": {
                "pkcs12_cert_file": "",
                "pkcs12_cert_password": ""
            }
        },
        "reg": {
            "name": "",
            "uuid_file": "/usr/local/bin/uuid",
            "platform_id": "george-ali",
            "deploy_env": "INSTANCE",
            "labels": ["daemonset"],
            "including_nics": ["eth0", "eth1"],
            "pod_name": "test",
            "namespace": "cloud-probe",
            "node_name": "test"
        },
        "worker": {
            "executable": "cpworker",
            "log_level": "INFO",
            "config_file": "cpm-worker.json",
            "unix_socket": "cpm-worker.sock",
            "cpu_affinity": -1
        }
    }
}