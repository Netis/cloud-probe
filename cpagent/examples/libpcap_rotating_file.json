{
    "tasks": [
        {
            "interface": "eth0",
            "snaplen": 2048,
            "req_pattern": {
                "type": "auto"
            },
            "capturer": {
                "type": "libpcap",
                "libpcap": {
                    "buffer_size_mb": 256
                }
            },
            "outputs": [
                {
                    "type": "rotating_file",
                    "rate_limit_mbps": 10,
                    "rotating_file": {
                        "file_root": "tmp/rotating_file",
                        "max_file_interval": 5
                    }
                }
            ]
        }
    ]
}