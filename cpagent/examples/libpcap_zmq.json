{
    "tasks": [
        {
            "interface": "eth0",
            "snaplen": 2048,
            "req_pattern": {
                "type": "auto"
            },
            "capturer": {
                "type": "libpcap",
                "libpcap": {
                    "buffer_size_mb": 256
                }
            },
            "outputs": [
