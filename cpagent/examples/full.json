{
    "cpu_affinity": 1,
    "log_level": "INFO",
    "unix_socket": "/var/run/cloud-probe/cpagent.sock",
    "tasks": [
        {
            "interface": "eth0",
            "snaplen": 2048,
            "netns": "/proc/1432897/ns/net",
            "req_pattern": {
                "type": "custom",
                "custom": {
                    "pattern": "host nic.eth0 and port 8011"
                }
            },
            "capturer": {
                "type": "libpcap",
                "libpcap": {
                    "bpf": "host nic.eth0",
                    "buffer_size_mb": 256,
                    "timeout_ms": 3
                }
            },
            "outputs": [
                {
                    "type": "file",
                    "rate_limit_mbps": 10,
                    "slice": 2048,
                    "vxlan": {
                        "host": "10.1.2.3",
                        "port": 4789,
                        "capture_time": false,
                        "vni1": 1,
                        "vni2": 33,
                        "bind_device": "eth3",
                        "pmtudisc": "want"
                    },
                    "gre": {
                        "host": "10.1.2.3",
                        "service_tag": 34,
                        "bind_device": "eth3",
                        "pmtudisc": "want"
                    },
                    "zmq": {
                        "host": "10.1.2.3",
                        "port": 1234,
                        "hwm": 1000,
                        "service_tag": 3
                    },
                    "file": {
                        "name": "tmp/test.pcap"
                    },
                    "rotating_file": {
                        "file_root": "tmp",
                        "max_file_interval": 60
                    }
                }
            ]
        }
    ]
}